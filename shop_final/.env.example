NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
# Set to 1 only when a trusted reverse proxy sits in front of Node.
TRUST_PROXY=0

# Initial admin. Used only when no admin/manager account exists yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisImmediately-Long-Password!

STORE_NAME=ShopEasy
STORE_CURRENCY=EUR
DEFAULT_LOCALE=en-GB
STORE_TIMEZONE=Europe/Brussels
# Consumer-facing prices should include applicable taxes before launch.
PRICES_INCLUDE_TAX=true
CHECKOUT_RESERVATION_MINUTES=60

# Set true only for local/demo preview data. Keep false for a real production store.
SEED_DEMO_DATA=false

# Optional AI. Leave all blank to remove/disable the AI feature.
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Live payment configuration. The checkout is intentionally disabled until all values are set.
STRIPE_SECRET_KEY=
# Production must use an sk_live_ or rk_live_ key.
STRIPE_WEBHOOK_SECRET=

# Transactional order confirmations. Resend uses https://api.resend.com/emails.
# EMAIL_FROM must be a sender/domain configured with your email provider.
RESEND_API_KEY=
EMAIL_FROM=

# Extra time before local stock cleanup, allowing payment webhooks to arrive after provider expiry.
# Release pending local stock only after the provider expiry grace window.
RESERVATION_RELEASE_GRACE_MINUTES=10
