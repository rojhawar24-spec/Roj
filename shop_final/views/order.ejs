<%- include('partials/header',{title:`Order #${order.id}`}) %>
<section class="container page-head"><%- include('partials/back-button', { fallback: '/account' }) %><span class="eyebrow">ORDER</span><h1>#<%= order.id %></h1><div class="hero-actions print-actions"><button type="button" class="btn btn-light" data-print-order>Print / save PDF</button></div><p><span class="status status-<%= order.status %>"><%= order.status %></span> · <%= formatDateTimeDisplay(order.created_at,storeTimeZone) %></p></section>
<section class="container order-layout"><div class="panel"><h2>Items</h2><% order.items.forEach(i=>{ %><div class="order-item"><span><%= i.product_name %> × <%= i.quantity %></span><strong><%= formatPrice(i.total_cents,order.currency) %></strong></div><% }) %><div class="rule"></div><div class="summary-row"><span>Items subtotal</span><strong><%= formatPrice(order.subtotal_cents,order.currency) %></strong></div><% if(order.automatic_discount_cents>0){ %><div class="summary-row"><span>Automatic product discounts</span><strong>-<%= formatPrice(order.automatic_discount_cents,order.currency) %></strong></div><% } %><% if(order.discount_cents>0){ %><div class="summary-row"><span>Coupon discount</span><strong>-<%= formatPrice(order.discount_cents,order.currency) %></strong></div><% } %><div class="summary-row"><span>Shipping</span><strong><%= order.shipping_cents===0?'Free':formatPrice(order.shipping_cents,order.currency) %></strong></div><div class="summary-row total"><span>Total</span><strong><%= formatPrice(order.total_cents,order.currency) %></strong></div></div><aside class="panel"><h2>Delivery</h2><p><strong><%= order.shipping_name %></strong><br><%= order.shipping_address %><br><%= order.shipping_postal_code %> <%= order.shipping_city %><br><%= order.shipping_country %></p><% if(order.customer_note){ %><div class="rule"></div><h2>Order note</h2><p class="policy-copy"><%= order.customer_note %></p><% } %><p class="muted">Payment: <%= order.payment_provider %></p></aside></section>
<%- include('partials/footer') %>