<%- include('partials/header',{title:cancelled?'Checkout cancelled':'Order status'}) %>
<section class="auth-wrap"><div class="auth-card success-card"><div class="success-mark"><%= cancelled?'!':'✓' %></div><span class="eyebrow"><%= cancelled?'ORDER CANCELLED':'ORDER #'+order.id %></span><h1><%= cancelled?'This order was cancelled.':order.payment_provider==='cash_on_delivery'?'Order received.':'Order received.' %></h1><% if(cancelled){ %><p><%= waitingForProviderExpiry?'Your payment session is still open. The order will be released automatically when the payment session expires. You can return to your cart, but this payment session must not be paid again.':'The reserved stock was released. You can return to your cart and try again.' %></p><% } else if(order.payment_provider==='cash_on_delivery'){ %><p><%= order.status==='pending'?'The manager will confirm your order and deliver it. Pay cash when your order arrives.':order.payment_reference?'Your order is complete and cash payment was recorded.':`Your order is ${order.status}. Pay cash when it is delivered.` %></p><div class="success-summary"><span>Total · cash on delivery</span><strong><%= formatPrice(order.total_cents,order.currency) %></strong></div><% } else if(order.status==='pending'){ %><p>Your payment provider has not confirmed the order yet. Check your account again shortly.</p><% } else { %><p>Your order is now <strong><%= order.status %></strong>. Thank you for shopping with us.</p><div class="success-summary"><span>Total</span><strong><%= formatPrice(order.total_cents,order.currency) %></strong></div><% } %><div class="hero-actions"><a class="btn btn-dark" href="/account">View account</a><a class="text-link" href="/shop">Continue shopping →</a></div></div></section>
<%- include('partials/footer') %>
