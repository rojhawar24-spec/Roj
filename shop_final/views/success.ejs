<%- include('partials/header',{title:cancelled?'Checkout cancelled':'Order status'}) %>
<section class="auth-wrap"><div class="auth-card success-card"><div class="success-mark"><%= cancelled?'!':'✓' %></div><span class="eyebrow"><%= cancelled?'CHECKOUT CANCELLED':'ORDER #'+order.id %></span><h1><%= cancelled?'Payment was not completed.':order.status==='pending'?'Payment is being confirmed.':'Order received.' %></h1><% if(cancelled){ %><p><%= waitingForProviderExpiry?'Your payment session is still open. The order will be released automatically when the payment session expires. You can return to your cart, but this payment session must not be paid again.':'Your payment was not completed and the reserved stock has been released. You can return to your cart and try again.' %></p><% } else if(order.status==='pending'){ %><p>Your payment provider has not confirmed the order yet. Keep this page open or check your account again shortly.</p><% } else { %><p>Your order is now <strong><%= order.status %></strong>. Thank you for shopping with us.</p><div class="success-summary"><span>Total</span><strong><%= formatPrice(order.total_cents,order.currency) %></strong></div><% } %><div class="hero-actions"><a class="btn btn-dark" href="/account">View account</a><a class="text-link" href="/shop">Continue shopping →</a></div></div></section>
<%- include('partials/footer') %>
