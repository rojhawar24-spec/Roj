<%- include('partials/header',{title:'Checkout'}) %>
<section class="container page-head checkout-head"><div><span class="eyebrow">SECURE CHECKOUT · 1 STEP</span><h1>Complete your order.</h1><p>We need your email, phone number and delivery location so the order can be processed and the manager can fulfil it.</p></div></section>
<section class="container checkout-layout">
<form class="panel form-stack" method="post" action="/checkout" data-submit-once>
  <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="idempotencyKey" value="<%= idempotencyKey %>"><% if(guestAccessToken){ %><input type="hidden" name="guestAccessToken" value="<%= guestAccessToken %>"><% } %>
  <% if(error){ %><div class="alert" role="alert"><%= error %></div><% } %>
  <div class="checkout-note"><span class="security-icon">✓</span><div><strong>Your information is protected.</strong><p>We use these details to identify the order, contact you about delivery and show the order to the authorised store manager. Card numbers stay with the payment provider.</p></div></div>
  <h2>Contact</h2>
  <label>Email address *<input type="email" name="customerEmail" required maxlength="120" autocomplete="email" placeholder="Enter your email address" value="<%= customerEmail||user?.email||'' %>" <%= paymentMode==='stripe'?'readonly':'' %> aria-describedby="email-note"><span id="email-note" class="field-note"><%= paymentMode==='cash_on_delivery'?'The manager uses this to contact you about delivery. No account is required for cash on delivery.':'Your signed-in account email is used for order confirmation.' %></span></label>
  <label>Phone number *<input name="customerPhone" required maxlength="32" autocomplete="tel" inputmode="tel" enterkeyhint="next" placeholder="+32 4 123 45 67"><span class="field-note">Required so the store can contact you about delivery. It is not used for marketing.</span></label>
  <div class="checkout-essentials"><strong>Payment:</strong> <%= paymentMode==='cash_on_delivery'?'Pay cash to the manager when your order is delivered.':'Secure online payment via Stripe.' %><br><strong>Prices:</strong> Consumer prices are configured as tax-inclusive.</div><h2>Delivery</h2>
  <div class="form-two"><label>Full name *<input name="shippingName" required maxlength="120" autocomplete="name"></label><label>Postal code *<input name="shippingPostalCode" required maxlength="20" autocomplete="postal-code" enterkeyhint="next"></label></div>
  <label>Street address *<input name="shippingAddress" required maxlength="200" autocomplete="street-address"></label>
  <div class="form-two"><label>City / town *<input name="shippingCity" required maxlength="100" autocomplete="address-level2"></label><label>Country / region *<input list="country-options" name="shippingCountry" required maxlength="80" autocomplete="country" placeholder="Belgium"><datalist id="country-options"><option value="Belgium"><option value="Netherlands"><option value="France"><option value="Germany"><option value="Luxembourg"><option value="United Kingdom"><option value="Other"></datalist></label></div>
  <label>Order note <span class="field-note">Optional · max 500 characters</span><textarea name="customerNote" maxlength="500" rows="4" placeholder="Delivery note or another useful detail"></textarea></label>
  <label class="checkbox-inline"><input type="checkbox" name="termsAccepted" required> I have read and accept the <a href="/terms" target="_blank" rel="noopener noreferrer">store terms</a>.</label>
  <% if(!storeReady){ %><button class="btn btn-dark btn-wide" disabled>Orders are not available yet</button><p class="micro-copy">The manager still needs to complete the store identity, tax and customer policies.</p><% } else if(paymentMode==='cash_on_delivery'){ %><button class="btn btn-mint btn-wide">Place cash-on-delivery order →</button><p class="micro-copy">The manager will accept your order, deliver it and collect cash. No online payment is taken.</p><% } else { %><button class="btn btn-mint btn-wide">Place order — pay online →</button><p class="micro-copy">Before payment, the server checks prices, discounts, stock, shipping and the final total. You will continue to secure Stripe checkout.</p><% } %>
</form>
<aside class="summary"><div class="summary-head">Your order</div><% summary.items.forEach(i=>{ %><div class="order-item"><span><%= i.product.name %> × <%= i.quantity %><% if(i.automaticDiscountPercent>0){ %><small class="muted"> · -<%= i.automaticDiscountPercent %>%</small><% } %></span><strong><%= formatPrice(app.locals.effectivePrice(i.product)*i.quantity,currency) %></strong></div><% }) %><div class="rule"></div><div class="summary-row"><span>Items subtotal</span><strong><%= formatPrice(summary.subtotalBeforeAutomaticDiscount,currency) %></strong></div><% if(summary.automaticDiscount>0){ %><div class="summary-row"><span>Automatic item discounts</span><strong>-<%= formatPrice(summary.automaticDiscount,currency) %></strong></div><% } %><% if(summary.discount>0){ %><div class="summary-row"><span>Coupon</span><strong>-<%= formatPrice(summary.discount,currency) %></strong></div><% } %><div class="summary-row"><span>Shipping</span><strong><%= summary.shipping===0?'Free':formatPrice(summary.shipping,currency) %></strong></div><div class="summary-row total"><span>Total</span><strong><%= formatPrice(summary.total,currency) %></strong></div></aside>
</section>
<%- include('partials/footer') %>
