<%- include('partials/header',{title:mode==='register'?'Create account':'Sign in'}) %>
<section class="auth-wrap"><div class="auth-card"><span class="eyebrow"><%= mode==='register'?'NEW CUSTOMER':'WELCOME BACK' %></span><h1><%= mode==='register'?'Create your account':'Sign in' %></h1><p class="muted"><%= mode==='register'?'Save orders and make checkout faster.':'Access your account and order history.' %></p><% if(error){ %><div class="alert" role="alert"><%= error %></div><% } %><% if(mode==='register'){ %><form class="form-stack" method="post" action="/register"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Email<input type="email" name="email" required maxlength="120" autocomplete="email"></label><label>Password<input type="password" name="password" required minlength="12" maxlength="200" autocomplete="new-password"></label><button class="btn btn-dark btn-wide">Create account</button></form><p class="switch-auth">Already have an account? <a href="/login">Sign in</a></p><% } else { %><form class="form-stack" method="post" action="/login"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= next %>"><label>Email<input type="email" name="email" required maxlength="120" autocomplete="email"></label><label>Password<input type="password" name="password" required maxlength="200" autocomplete="current-password"></label><button class="btn btn-dark btn-wide">Sign in</button></form><p class="switch-auth">New here? <a href="/login?mode=register">Create an account</a></p><% } %></div></section>
<%- include('partials/footer') %>
