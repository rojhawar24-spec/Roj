<%- include('partials/header',{title:mode==='register'?'Create account':'Sign in'}) %>
<section class="auth-wrap"><div class="auth-card"><nav class="auth-tabs" aria-label="Account access"><a href="/login" <%= mode==='login'?'aria-current="page"':'' %>>Sign in</a><a href="/register" <%= mode==='register'?'aria-current="page"':'' %>>Create account</a></nav><span class="eyebrow"><%= mode==='register'?'NEW CUSTOMER':'WELCOME BACK' %></span><h1><%= mode==='register'?'Create your account':'Welcome back' %></h1><p class="muted"><%= mode==='register'?'Join ShopEasy to track orders and check out faster.':'Sign in to your ShopEasy account.' %></p><% if(error){ %><div class="alert" role="alert"><%= error %></div><% } %><% if(mode==='register'){ %><form class="form-stack" method="post" action="/register"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Full name<input type="text" name="fullName" required maxlength="120" autocomplete="name" placeholder="Enter your full name" value="<%= fullName||'' %>"></label><label>Email address<input type="email" name="email" required maxlength="120" autocomplete="email" placeholder="Enter your email address" value="<%= email||'' %>"></label><label>Password<input type="password" name="password" required minlength="12" maxlength="200" autocomplete="new-password" placeholder="Create a password"><span class="field-note">Use at least 12 characters.</span></label><label>Confirm password<input type="password" name="confirmPassword" required minlength="12" maxlength="200" autocomplete="new-password" placeholder="Re-enter your password"></label><label class="checkbox-inline auth-terms"><input type="checkbox" name="termsAccepted" required><span>I agree to the <a href="/terms" target="_blank" rel="noopener">Terms & Conditions</a> and <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>.</span></label><button class="btn btn-dark btn-wide">Create account</button></form><p class="switch-auth">Already have an account? <a href="/login">Sign in</a></p><% } else { %><form class="form-stack" method="post" action="/login"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= next %>"><label>Email address<input type="email" name="email" required maxlength="120" autocomplete="email" placeholder="Enter your email address" value="<%= email||'' %>"></label><label>Password<input type="password" name="password" required maxlength="200" autocomplete="current-password" placeholder="Enter your password"></label><label class="checkbox-inline auth-remember"><input type="checkbox" name="rememberMe"> Remember me</label><button class="btn btn-dark btn-wide">Sign in</button></form><p class="switch-auth">Don’t have an account yet? <a href="/register">Create an account</a></p><% } %></div></section>
<%- include('partials/footer') %>
