<%- include('partials/header',{title:'Shop'}) %>
<section class="container page-head"><div><span class="eyebrow">COLLECTION</span><h1>Shop everything.</h1><p>Search by product, SKU, tags or descriptions. Filter by category and sort in one tap.</p></div></section>
<section class="container section shop-section">
  <form class="shop-controls" method="get" action="/shop">
    <div class="filter-block"><label for="category-filter">Category</label><select id="category-filter" name="category"><option value="">All categories</option><% categories.forEach(c=>{ %><option value="<%= c.slug %>" <%= category===c.slug?'selected':'' %>><%= c.name %></option><% }) %></select></div>
    <div class="filter-block"><label for="sort-filter">Sort</label><select id="sort-filter" name="sort"><option value="featured" <%= sort==='featured'||!sort?'selected':'' %>>Featured</option><option value="newest" <%= sort==='newest'?'selected':'' %>>Newest</option><option value="price_low" <%= sort==='price_low'?'selected':'' %>>Price: low to high</option><option value="price_high" <%= sort==='price_high'?'selected':'' %>>Price: high to low</option><option value="name" <%= sort==='name'?'selected':'' %>>Name: A–Z</option></select></div>
    <div class="filter-search"><label for="shop-search">Search</label><div class="inline-search"><input id="shop-search" name="search" value="<%= search %>" maxlength="80" placeholder="e.g. bottle, travel, ASTRA"><button class="btn btn-dark">Search</button></div></div>
  </form>
  <div class="shop-toolbar"><div class="chips"><a class="chip <%= !category?'active':'' %>" href="/shop<%= search?'?search='+encodeURIComponent(search):'' %>">All</a><% categories.forEach(c=>{ %><a class="chip <%= category===c.slug?'active':'' %>" href="/shop?category=<%= encodeURIComponent(c.slug) %><%= search?'&search='+encodeURIComponent(search):'' %><%= sort?'&sort='+encodeURIComponent(sort):'' %>"><%= c.name %></a><% }) %></div><span class="toolbar-note">Page <%= page %> · English</span></div>
  <% if(!products.length){ %><div class="empty"><span class="empty-icon">⌕</span><h2>No products found.</h2><p>Try fewer words, another category or a different sort order.</p><a class="btn btn-dark" href="/shop">Reset shop</a></div><% } else { %>
  <div class="result-heading"><strong><%= resultCount %> product<%= resultCount===1?'':'s' %></strong><span>English · prices and availability update from the server</span></div>
  <div class="product-grid shop-grid"><% products.forEach(p=>{ %><article class="product-card"><a href="/product/<%= p.slug %>" class="product-image"><img src="<%= safeImageUrl(p.image_url) %>" alt="<%= p.name %>" width="800" height="1000" loading="lazy" decoding="async"><% if(app.locals.discountPercent(p)>0){ %><span class="badge sale">-<%= app.locals.discountPercent(p) %>%</span><% } %><% if(p.available_stock<=0){ %><span class="badge out">Sold out</span><% } %></a><div class="product-meta"><div><span class="muted"><%= p.category_name || 'Collection' %></span><h3><a href="/product/<%= p.slug %>"><%= p.name %></a></h3></div><div class="price"><strong><%= formatPrice(app.locals.effectivePrice(p),currency) %></strong><% if(app.locals.effectivePrice(p)<p.price_cents){ %><del><%= formatPrice(p.price_cents,currency) %></del><% } %></div></div><p class="product-blurb"><%= p.short_description %></p><div class="card-actions"><form method="post" action="/cart/add" class="card-buy"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="productId" value="<%= p.id %>"><input type="hidden" name="quantity" value="1"><button class="btn btn-dark btn-small" <%= p.available_stock<=0?'disabled':'' %>><%= p.available_stock>0?'Add to bag':'Sold out' %></button></form><% if(isLoggedIn){ %><button type="button" class="icon-btn wishlist-toggle <%= wishlistIds.has(p.id)?'saved':'' %>" data-wishlist-toggle data-product-id="<%= p.id %>" data-product-name="<%= p.name %>" aria-label="<%= wishlistIds.has(p.id)?'Remove':'Add' %> <%= p.name %> to wishlist" aria-pressed="<%= wishlistIds.has(p.id)?'true':'false' %>"><%= wishlistIds.has(p.id)?'♥':'♡' %></button><% } %></div></article><% }) %></div>
  <div class="pagination"><% if(hasPrev){ %><a class="btn btn-light btn-small" href="/shop?page=<%= page-1 %><%= category?'&category='+encodeURIComponent(category):'' %><%= search?'&search='+encodeURIComponent(search):'' %><%= sort?'&sort='+encodeURIComponent(sort):'' %>">← Previous</a><% } else { %><span></span><% } %><span>Page <strong><%= page %></strong></span><% if(hasNext){ %><a class="btn btn-dark btn-small" href="/shop?page=<%= page+1 %><%= category?'&category='+encodeURIComponent(category):'' %><%= search?'&search='+encodeURIComponent(search):'' %><%= sort?'&sort='+encodeURIComponent(sort):'' %>">Next →</a><% } else { %><span></span><% } %></div>
  <% } %>
</section>
<%- include('partials/footer') %>
