<%- include('../partials/header',{title:'Store settings'}) %><nav class="admin-nav container" aria-label="Store manager navigation"><a href="/admin">Overview</a><a href="/admin/products">Products</a><a href="/admin/categories">Categories</a><a href="/admin/orders">Orders</a><a href="/admin/stories">Stories</a><a href="/admin/coupons">Discounts</a><a href="/admin/customers">Customers</a><a href="/admin/audit">Audit</a><a class="active" aria-current="page" href="/admin/settings">Settings</a></nav>
<section class="container page-head admin-head"><div><span class="eyebrow">SETUP & INTEGRATIONS</span><h1>Settings.</h1><p>Configure the store identity, customer policies, payment readiness and optional AI. Keep secrets on the server — never in this page.</p></div><span class="status <%= storeReady?'':'off' %>"><%= storeReady?'Launch ready':'Launch blocked' %></span></section>
<% const launchChecks=[['Store name',Boolean(storeName?.trim())],['Legal / business name',Boolean(legalName?.trim())],['Business address',Boolean(businessAddress?.trim())],['Valid support email',/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(supportEmail)],['Business phone (7+ characters)',String(businessPhone||'').length>=7],['Registration number (6+ characters)',String(enterpriseNumber||'').length>=6],['Consumer prices include tax',pricesIncludeTax],['Privacy policy (40+ characters)',String(privacyPolicy||'').trim().length>=40],['Terms & conditions (40+ characters)',String(termsPolicy||'').trim().length>=40],['Shipping policy (40+ characters)',String(shippingPolicy||'').trim().length>=40],['Returns policy (40+ characters)',String(returnsPolicy||'').trim().length>=40],['At least one in-stock product',Number(sellableProductCount)>0],['Payment method',paymentMode==='cash_on_delivery'||(stripeEnabled&&emailEnabled)]]; const missingLaunchChecks=launchChecks.filter(([,complete])=>!complete).map(([label])=>label); %>
<section class="container settings-checklist-wrap"><div class="settings-checklist" role="status"><strong><%= storeReady?'Cash checkout is ready.':'Save is blocked until these requirements are complete:' %></strong><% if(missingLaunchChecks.length){ %><ul><% missingLaunchChecks.forEach(item=>{ %><li><%= item %></li><% }) %></ul><% } else { %><p>All launch requirements are complete.</p><% } %><small>Cash on delivery does not require Stripe or order email. Fill the required fields below; the browser cannot submit while required entries are empty.</small></div></section>
<section class="container form-page"><% if(error){ %><div class="alert" role="alert"><%= error %></div><% } %><form class="panel form-stack" method="post" action="/admin/settings"><input type="hidden" name="_csrf" value="<%= csrf %>">
<div class="form-section"><span class="eyebrow">01 · IDENTITY</span><h2>Store identity</h2><label>Store name<input name="storeName" maxlength="100" required value="<%= storeName %>"></label><label>Legal / business name<input name="legalName" maxlength="160" required value="<%= legalName %>"></label><label>Business address<input name="businessAddress" maxlength="500" required value="<%= businessAddress %>"></label><div class="form-two"><label>Support email<input type="email" name="supportEmail" maxlength="160" required value="<%= supportEmail %>"></label><label>Business phone<input name="businessPhone" maxlength="40" required value="<%= businessPhone %>" autocomplete="tel"><span class="field-note">Customers need a direct phone contact for the business.</span></label></div><div class="form-two"><label>Enterprise / registration number<input name="enterpriseNumber" maxlength="40" required value="<%= enterpriseNumber %>"><span class="field-note">For a Belgian business, enter the 10-digit ondernemingsnummer.</span></label><label>VAT number (if applicable)<input name="vatNumber" maxlength="40" value="<%= vatNumber %>"><span class="field-note">Example format: BE 0123.456.789.</span></label></div><label class="checkbox-inline"><input type="checkbox" name="pricesIncludeTax" <%= pricesIncludeTax?'checked':'' %>> Consumer prices include applicable taxes</label><div class="form-two"><label>Currency<select name="currency" required aria-describedby="currency-note"><% (availableCurrencies || ['EUR']).forEach(code=>{ %><option value="<%= code %>" <%= String(currency).toUpperCase()===code?'selected':'' %>><%= code %></option><% }) %></select><span id="currency-note" class="field-note">Only currencies supported safely by this checkout configuration are available.</span></label><label>Flat shipping fee<input name="shippingFee" inputmode="decimal" placeholder="0.00" value="<%= (Number(shippingFeeCents||0)/100).toFixed(2) %>"><span class="field-note">Use 0.00 for free shipping.</span></label></div></div>
<div class="form-section"><span class="eyebrow">02 · PAYMENTS & EMAIL</span><h2>Customer communications</h2><div class="integration"><div><strong><%= paymentMode==='cash_on_delivery'?'Cash on delivery selected':stripeEnabled?'Stripe configured':'Stripe not configured' %></strong><span><%= paymentMode==='cash_on_delivery'?'Customers pay the manager in cash when the order is delivered.':'Live payment credentials stay on the server.' %></span></div></div><div class="integration"><div><strong><%= emailEnabled?'Order email configured':paymentMode==='cash_on_delivery'?'Order email optional for cash orders':'Order email not configured' %></strong><span><%= emailEnabled?'Paid orders receive a durable confirmation email.':'Customers can still follow cash orders in their account.' %></span></div></div><p class="field-note">Email uses the server-side transactional email provider configured in environment variables.</p></div><div class="form-section"><span class="eyebrow">03 · OPTIONAL AI</span><h2>AI shopping assistant</h2><div class="integration highlight"><div><strong><%= aiEnabled?'AI is ON':'AI is OFF' %></strong><span><%= aiEnabled?'Customers can ask short product questions.':'The shop works normally without AI.' %></span></div><label class="switch"><input type="checkbox" name="aiEnabled" <%= aiEnabled?'checked':'' %>><span class="switch-ui" aria-hidden="true"></span><span>Enable AI</span></label></div><div class="tip-box"><strong>Easy to add or remove.</strong><br>API credentials and model settings live only in server environment variables. This switch only enables the feature when the provider is configured. To remove AI completely, remove <code>src/services/ai.js</code>; the application safely continues without it.</div></div>
<div class="form-section"><span class="eyebrow">04 · CUSTOMER POLICIES</span><h2>What customers need to know</h2><label>Privacy policy<textarea name="privacyPolicy" minlength="40" maxlength="12000" rows="9" required><%= privacyPolicy %></textarea></label><label>Terms & conditions<textarea name="termsPolicy" minlength="40" maxlength="12000" rows="9" required><%= termsPolicy %></textarea></label><label>Shipping policy<textarea name="shippingPolicy" minlength="40" maxlength="8000" rows="7" required><%= shippingPolicy %></textarea></label><label>Returns / refunds policy<textarea name="returnsPolicy" minlength="40" maxlength="8000" rows="7" required><%= returnsPolicy %></textarea></label></div>
<button class="btn btn-mint btn-wide">Save settings</button></form>
<div class="panel setup-status"><div class="panel-head"><div><span class="eyebrow">LAUNCH CHECK</span><h2>Can customers buy?</h2></div></div><div class="integration"><span>Language</span><strong>English (EN)</strong></div><div class="integration"><span>Transactional email</span><strong><%= emailEnabled?'Configured':paymentMode==='cash_on_delivery'?'Optional for cash':'Not configured' %></strong></div><div class="integration"><span>Consumer prices include tax</span><strong><%= pricesIncludeTax?'Confirmed':'Not confirmed' %></strong></div><div class="integration"><span>Sellable products</span><strong><%= sellableProductCount %> available</strong></div><div class="integration"><span>AI provider</span><strong><%= aiEnabled?'Available & enabled':'Disabled' %></strong></div><div class="integration"><span>Payment method</span><strong><%= paymentMode==='cash_on_delivery'?'Cash on delivery':stripeEnabled?'Stripe configured':'Stripe not configured' %></strong></div><div class="integration"><span>Business identity + policies</span><strong><%= storeReady?'Complete':'Incomplete' %></strong></div><div class="integration"><span>Checkout</span><strong><%= storeReady?'Ready':'Blocked' %></strong></div><p class="muted">Before accepting real orders, configure accurate legal business details, tax-inclusive pricing, shipping and customer policies for your market.</p></div></section>
<%- include('../partials/footer') %>