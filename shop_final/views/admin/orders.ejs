<%- include('../partials/header',{title:'Orders'}) %><nav class="admin-nav container" aria-label="Store manager navigation"><a href="/admin">Overview</a><a href="/admin/products">Products</a><a href="/admin/categories">Categories</a><a class="active" aria-current="page" href="/admin/orders">Orders</a><a href="/admin/stories">Stories</a><a href="/admin/coupons">Discounts</a><a href="/admin/customers">Customers</a><a href="/admin/audit">Audit</a><a href="/admin/settings">Settings</a></nav>
<section class="container page-head admin-head"><%- include('../partials/back-button', { fallback: '/admin' }) %><div><span class="eyebrow">COMMERCE</span><h1>Orders</h1><p>Search by order number or customer email, filter by status and review every fulfillment step.</p></div></section>
<section class="container section"><form class="admin-filters panel" method="get" action="/admin/orders"><div><label for="order-search">Search</label><input id="order-search" name="search" value="<%= search %>" maxlength="80" placeholder="Order # or customer email"></div><div><label for="order-status">Status</label><select id="order-status" name="status"><option value="">All statuses</option><% ['pending','paid','processing','shipped','completed','cancelled'].forEach(s=>{ %><option value="<%= s %>" <%= status===s?'selected':'' %>><%= s.charAt(0).toUpperCase()+s.slice(1) %></option><% }) %></select></div><button class="btn btn-dark">Filter orders</button><a class="btn btn-light" href="/admin/orders">Reset</a></form></section>
<section class="container section section-topless"><div class="table-meta"><span><strong><%= total %></strong> matching orders</span><span>Page <%= page %></span></div><div class="panel table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th><th>Date</th></tr></thead><tbody><% orders.forEach(o=>{ %><tr><td><a class="table-link" href="/admin/orders/<%= o.id %>">#<%= o.id %></a></td><td><%= o.email %></td><td><strong><%= formatPrice(o.total_cents,o.currency) %></strong></td><td><span class="status status-<%= o.status %>"><%= o.status %></span></td><td><%= formatDateTimeDisplay(o.created_at,storeTimeZone) %></td></tr><% }) %><% if(!orders.length){ %><tr><td colspan="5"><div class="empty compact"><h3>No orders found.</h3><a href="/admin/orders" class="text-link">Clear filters →</a></div></td></tr><% } %></tbody></table></div>
<div class="pagination"><% if(hasPrev){ %><a class="btn btn-light btn-small" href="/admin/orders?page=<%= page-1 %>&search=<%= encodeURIComponent(search) %>&status=<%= encodeURIComponent(status) %>">← Previous</a><% } else { %><span></span><% } %><span>Page <strong><%= page %></strong></span><% if(hasNext){ %><a class="btn btn-dark btn-small" href="/admin/orders?page=<%= page+1 %>&search=<%= encodeURIComponent(search) %>&status=<%= encodeURIComponent(status) %>">Next →</a><% } else { %><span></span><% } %></div></section>
<%- include('../partials/footer') %>