<%- include('../partials/header',{title:'Stories'}) %><nav class="admin-nav container" aria-label="Store manager navigation"><a href="/admin">Overview</a><a href="/admin/products">Products</a><a href="/admin/categories">Categories</a><a href="/admin/orders">Orders</a><a class="active" aria-current="page" href="/admin/stories">Stories</a><a href="/admin/coupons">Discounts</a><a href="/admin/customers">Customers</a><a href="/admin/audit">Audit</a><a href="/admin/settings">Settings</a></nav>
<section class="container page-head admin-head"><%- include('../partials/back-button', { fallback: '/admin' }) %><div><span class="eyebrow">CONTENT</span><h1>Stories</h1><p>Publish short updates that expire automatically.</p></div><a class="btn btn-dark" href="/admin/stories/new">+ Add story</a></section>
<section class="container section"><div class="panel table-wrap"><table><thead><tr><th>Story</th><th>Published</th><th>Expires</th><th>Status</th><th></th></tr></thead><tbody><% stories.forEach(s=>{ %><tr><td><div class="table-product"><img src="<%= safeImageUrl(s.image_url,'/assets/story.svg') %>" alt=""><div><strong><%= s.title %></strong><span><%= s.product_name||'Store story' %></span></div></div></td><td><%= formatDateTimeDisplay(s.published_at,storeTimeZone) %></td><td><%= formatDateTimeDisplay(s.expires_at,storeTimeZone) %></td><td><span class="status <%= s.active?'':'off' %>"><%= s.active?'Active':'Hidden' %></span></td><td class="table-actions"><a class="btn btn-light btn-small" href="/admin/stories/<%= s.id %>/edit">Edit</a><form method="post" action="/admin/stories/delete" data-confirm="Delete this story?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= s.id %>"><button class="btn btn-danger btn-small">Delete</button></form></td></tr><% }) %></tbody></table></div></section>
<%- include('../partials/footer') %>