<%- include('../partials/header',{title:'Categories'}) %><nav class="admin-nav container" aria-label="Store manager navigation"><a href="/admin">Overview</a><a href="/admin/products">Products</a><a class="active" aria-current="page" href="/admin/categories">Categories</a><a href="/admin/orders">Orders</a><a href="/admin/stories">Stories</a><a href="/admin/coupons">Discounts</a><a href="/admin/customers">Customers</a><a href="/admin/audit">Audit</a><a href="/admin/settings">Settings</a></nav>
<section class="container page-head admin-head"><div><span class="eyebrow">CATALOG</span><h1>Categories</h1><p>Create, rename and remove the categories used across your product catalog.</p></div></section>
<section class="container admin-two-col section"><form class="panel form-stack" method="post" action="/admin/categories/save"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(editCategory?.id){ %><input type="hidden" name="id" value="<%= editCategory.id %>"><% } %><% if(error){ %><div class="alert" role="alert"><%= error %></div><% } %><h2><%= editCategory?.id?'Edit category':'Add category' %></h2><label>Category name *<input name="name" maxlength="80" required placeholder="Accessories" value="<%= editCategory?.name||'' %>"></label><div class="form-actions"><button class="btn btn-dark btn-wide"><%= editCategory?.id?'Save changes':'Add category' %></button><% if(editCategory?.id){ %><a class="btn btn-light btn-wide" href="/admin/categories">Cancel edit</a><% } %></div></form><div class="panel table-wrap"><table><thead><tr><th>Name</th><th>Slug</th><th></th></tr></thead><tbody><% categories.forEach(c=>{ %><tr><td><strong><%= c.name %></strong></td><td><code><%= c.slug %></code></td><td class="table-actions"><a class="btn btn-light btn-small" href="/admin/categories?edit=<%= c.id %>">Edit</a><form method="post" action="/admin/categories/delete" data-confirm="Delete category <%= c.name %>? Products will become uncategorized."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= c.id %>"><button class="btn btn-danger btn-small">Delete</button></form></td></tr><% }) %><% if(!categories.length){ %><tr><td colspan="3"><div class="empty compact"><h3>No categories yet.</h3><p class="muted">Add your first category to organize the catalog.</p></div></td></tr><% } %></tbody></table></div></section>
<%- include('../partials/footer') %>
