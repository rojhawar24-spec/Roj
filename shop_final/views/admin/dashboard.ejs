<%- include('../partials/header',{title:'Store manager'}) %>
<nav class="admin-nav container" aria-label="Store manager navigation"><a class="active" aria-current="page" href="/admin">Overview</a><a href="/admin/products">Products</a><a href="/admin/categories">Categories</a><a href="/admin/orders">Orders</a><a href="/admin/stories">Stories</a><a href="/admin/coupons">Discounts</a><a href="/admin/customers">Customers</a><a href="/admin/audit">Audit</a><a href="/admin/settings">Settings</a></nav>
<section class="container page-head admin-head"><div><span class="eyebrow">CONTROL ROOM</span><h1>Your store, at a glance.</h1><p>Everything the manager needs is one click away. Add products, create sales, publish stories and handle orders without touching code.</p></div><div class="quick-links"><a class="btn btn-mint" href="/admin/products/new">+ Add product</a><a class="btn btn-light" href="/shop">Preview store ↗</a></div></section>
<section class="container admin-grid"><a class="stat-card" href="/admin/products"><span>Products</span><strong><%= productCount %></strong><small><%= activeProducts %> live · <%= soldOutProducts %> sold out</small></a><a class="stat-card" href="/admin/orders"><span>Orders</span><strong><%= orderCount %></strong><small><%= pendingOrders %> waiting for payment</small></a><a class="stat-card" href="/admin/customers"><span>Customers</span><strong><%= customerCount %></strong><small>Accounts with protected order history</small></a><div class="stat-card"><span>Recorded revenue</span><strong><%= formatPrice(paidRevenue,currency) %></strong><small>Paid / fulfilled orders</small></div></section>
<section class="container section"><div class="admin-two-col">
  <div class="panel"><div class="panel-head"><div><span class="eyebrow">MANAGER FLOW</span><h2>Run the shop.</h2></div></div><div class="quick-links manager-flow"><a class="flow-card" href="/admin/categories"><span>01</span><strong>Categories</strong><small>Organise the catalogue</small></a><a class="flow-card" href="/admin/products/new"><span>02</span><strong>Product</strong><small>Price, sale, stock, image</small></a><a class="flow-card" href="/admin/coupons"><span>03</span><strong>Discount</strong><small>Coupons and expiry rules</small></a><a class="flow-card" href="/admin/stories/new"><span>04</span><strong>Story</strong><small>Timed promotions</small></a><a class="flow-card" href="/admin/orders"><span>05</span><strong>Orders</strong><small>Customer + delivery details</small></a><a class="flow-card" href="/admin/settings"><span>06</span><strong>Settings</strong><small>AI, payment and policies</small></a></div></div>
  <div class="panel"><div class="panel-head"><div><span class="eyebrow">CONTENT</span><h2>Stories</h2></div><span class="status"><%= liveStories %> live · <%= storyCount %> total</span></div><p class="muted">Create a story, attach a product, choose dates and publish. It automatically disappears after expiry.</p><a class="btn btn-dark" href="/admin/stories/new">+ Create story</a></div>
</div></section>
<section class="container section section-topless"><div class="panel"><div class="panel-head"><div><span class="eyebrow">LATEST ACTIVITY</span><h2>Recent orders</h2></div><a class="text-link" href="/admin/orders">View all →</a></div><div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Phone</th><th>Total</th><th>Status</th><th></th></tr></thead><tbody><% recentOrders.forEach(o=>{ %><tr><td><a class="table-link" href="/admin/orders/<%= o.id %>">#<%= o.id %></a></td><td><%= o.email %></td><td><%= o.customer_phone||'—' %></td><td><strong><%= formatPrice(o.total_cents,o.currency) %></strong></td><td><span class="status status-<%= o.status %>"><%= o.status %></span></td><td><a class="btn btn-light btn-small" href="/admin/orders/<%= o.id %>">Open</a></td></tr><% }) %><% if(!recentOrders.length){ %><tr><td colspan="6"><div class="empty compact"><h3>No orders yet.</h3><p class="muted">Orders will appear here after a successful checkout.</p></div></td></tr><% } %></tbody></table></div></div></section>
<%- include('../partials/footer') %>