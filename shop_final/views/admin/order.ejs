<%- include('../partials/header',{title:`Order #${order.id}`}) %><nav class="admin-nav container" aria-label="Store manager navigation"><a href="/admin">Overview</a><a href="/admin/products">Products</a><a href="/admin/categories">Categories</a><a class="active" aria-current="page" href="/admin/orders">Orders</a><a href="/admin/stories">Stories</a><a href="/admin/coupons">Discounts</a><a href="/admin/customers">Customers</a><a href="/admin/audit">Audit</a><a href="/admin/settings">Settings</a></nav>
<section class="container page-head admin-head"><div><span class="eyebrow">ORDER #<%= order.id %></span><h1>Customer order.</h1><p><%= order.email %> · <%= formatDateTimeDisplay(order.created_at,storeTimeZone) %></p></div><span class="status status-<%= order.status %>"><%= order.status %></span></section>
<section class="container order-layout"><div class="panel"><div class="panel-head"><div><span class="eyebrow">PURCHASE</span><h2>Items</h2></div></div><% order.items.forEach(i=>{ %><div class="order-item"><span><%= i.product_name %> × <%= i.quantity %></span><strong><%= formatPrice(i.total_cents,order.currency) %></strong></div><% }) %><div class="rule"></div><div class="summary-row"><span>Items subtotal</span><strong><%= formatPrice(order.subtotal_cents,order.currency) %></strong></div><% if(order.automatic_discount_cents>0){ %><div class="summary-row"><span>Automatic product discounts</span><strong>-<%= formatPrice(order.automatic_discount_cents,order.currency) %></strong></div><% } %><% if(order.discount_cents>0){ %><div class="summary-row"><span>Coupon discount</span><strong>-<%= formatPrice(order.discount_cents,order.currency) %></strong></div><% } %><div class="summary-row"><span>Shipping</span><strong><%= order.shipping_cents===0?'Free':formatPrice(order.shipping_cents,order.currency) %></strong></div><div class="summary-row total"><span>Total</span><strong><%= formatPrice(order.total_cents,order.currency) %></strong></div><div class="tip-box">The total shown here came from the server-side order record. The customer cannot edit it from the browser.</div></div>
<aside class="panel"><div class="panel-head"><div><span class="eyebrow">CUSTOMER</span><h2>Contact</h2></div></div><div class="customer-detail"><div><span>Email</span><strong><%= order.email %></strong></div><div><span>Phone</span><strong><%= order.customer_phone||'Not provided' %></strong></div><div><span>Full name</span><strong><%= order.shipping_name %></strong></div></div><div class="rule"></div><h2>Delivery location</h2><p><strong><%= order.shipping_name %></strong><br><%= order.shipping_address %><br><%= order.shipping_postal_code %> <%= order.shipping_city %><br><%= order.shipping_country %></p><% if(order.customer_note){ %><div class="tip-box"><strong>Customer note</strong><br><span class="policy-copy"><%= order.customer_note %></span></div><% } %><div class="rule"></div><h2>Fulfilment</h2><% if(order.status==='pending'){ %><p class="muted">Waiting for verified payment. Reserved stock is protected until the reservation expires or payment is confirmed.</p><% } else if(order.status==='completed'||order.status==='cancelled'){ %><p><span class="status status-<%= order.status %>"><%= order.status %></span></p><% } else { %><form method="post" action="/admin/orders/status" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= order.id %>"><% const next = order.status==='paid' ? 'processing' : order.status==='processing' ? 'shipped' : 'completed'; %><select name="status"><option value="<%= next %>">Move to <%= next %></option></select><button class="btn btn-dark">Update order status</button></form><% } %><p class="muted">Terms accepted: <%= order.terms_accepted_at?formatDateTimeDisplay(order.terms_accepted_at,storeTimeZone):'Not recorded' %></p><p class="muted">Payment: <%= order.payment_provider %><% if(order.payment_reference){ %><br>Reference: <%= order.payment_reference %><% } %></p></aside></section>
<%- include('../partials/footer') %>