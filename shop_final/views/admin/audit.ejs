<%- include('../partials/header',{title:'Audit log'}) %><nav class="admin-nav container" aria-label="Store manager navigation"><a href="/admin">Overview</a><a href="/admin/products">Products</a><a href="/admin/categories">Categories</a><a href="/admin/orders">Orders</a><a href="/admin/stories">Stories</a><a href="/admin/coupons">Discounts</a><a href="/admin/customers">Customers</a><a class="active" aria-current="page" href="/admin/audit">Audit</a><a href="/admin/settings">Settings</a></nav>
<section class="container page-head"><div><span class="eyebrow">SECURITY</span><h1>Audit log</h1><p>Important manager actions are recorded without storing secrets or payment credentials.</p></div></section>
<section class="container section"><div class="panel table-wrap"><table><thead><tr><th>Date</th><th>Actor</th><th>Action</th><th>Target</th></tr></thead><tbody><% logs.forEach(l=>{ %><tr><td><%= formatDateTimeDisplay(l.created_at,storeTimeZone) %></td><td><%= l.email || 'System' %></td><td><span class="action-chip action-<%= /delete|remove|cancel/i.test(l.action) ? 'danger' : /create|add|new/i.test(l.action) ? 'create' : /update|save|edit|status/i.test(l.action) ? 'update' : 'other' %>"><%= l.action %></span></td><td><%= l.target_type %><%= l.target_id ? ' #'+l.target_id : '' %></td></tr><% }) %><% if(!logs.length){ %><tr><td colspan="4"><div class="empty compact"><h3>No activity recorded yet.</h3><p class="muted">Manager actions will appear here.</p></div></td></tr><% } %></tbody></table></div></section>
<%- include('../partials/footer') %>