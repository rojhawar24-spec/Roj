<%- include('../partials/header',{title:`Cash order #${order.id}`}) %>
<nav class="admin-nav container" aria-label="Store manager navigation"><a href="/admin">Overview</a><a href="/admin/products">Products</a><a href="/admin/categories">Categories</a><a class="active" aria-current="page" href="/admin/orders">Orders</a><a href="/admin/stories">Stories</a><a href="/admin/coupons">Discounts</a><a href="/admin/customers">Customers</a><a href="/admin/audit">Audit</a><a href="/admin/settings">Settings</a></nav>
<section class="container page-head admin-head"><div><span class="eyebrow">CASH ON DELIVERY · ORDER #<%= order.id %></span><h1>Customer order.</h1><p><%= order.email %> · <%= formatDateTimeDisplay(order.created_at,storeTimeZone) %></p></div><span class="status status-<%= order.status %>"><%= order.status %></span></section>
<section class="container order-layout"><div class="panel"><div class="panel-head"><div><span class="eyebrow">PURCHASE</span><h2>Items</h2></div></div><% order.items.forEach(i=>{ %><div class="order-item"><span><%= i.product_name %> × <%= i.quantity %></span><strong><%= formatPrice(i.total_cents,order.currency) %></strong></div><% }) %><div class="rule"></div><div class="summary-row"><span>Items subtotal</span><strong><%= formatPrice(order.subtotal_cents,order.currency) %></strong></div><% if(order.automatic_discount_cents>0){ %><div class="summary-row"><span>Automatic product discounts</span><strong>-<%= formatPrice(order.automatic_discount_cents,order.currency) %></strong></div><% } %><% if(order.discount_cents>0){ %><div class="summary-row"><span>Coupon discount</span><strong>-<%= formatPrice(order.discount_cents,order.currency) %></strong></div><% } %><div class="summary-row"><span>Shipping</span><strong><%= order.shipping_cents===0?'Free':formatPrice(order.shipping_cents,order.currency) %></strong></div><div class="summary-row total"><span>Total · cash due on delivery</span><strong><%= formatPrice(order.total_cents,order.currency) %></strong></div></div>
<aside class="panel"><div class="panel-head"><div><span class="eyebrow">CUSTOMER</span><h2>Delivery details</h2></div></div><div class="customer-detail"><div><span>Email</span><strong><%= order.email %></strong></div><div><span>Phone</span><strong><%= order.customer_phone||'Not provided' %></strong></div><div><span>Full name</span><strong><%= order.shipping_name %></strong></div></div><p><strong><%= order.shipping_name %></strong><br><%= order.shipping_address %><br><%= order.shipping_postal_code %> <%= order.shipping_city %><br><%= order.shipping_country %></p><% if(order.customer_note){ %><div class="tip-box"><strong>Customer note</strong><br><span class="policy-copy"><%= order.customer_note %></span></div><% } %><div class="rule"></div><h2>Fulfilment</h2><% if(order.status==='pending'){ %><p class="muted">This order is waiting for your acceptance. Stock is reserved for up to 24 hours. Accept it to begin delivery.</p><div class="form-actions"><form method="post" action="/admin/orders/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= order.id %>"><input type="hidden" name="status" value="processing"><button class="btn btn-dark">Accept order</button></form><form method="post" action="/admin/orders/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= order.id %>"><input type="hidden" name="status" value="cancelled"><button class="btn btn-light">Decline</button></form></div><% } else if(order.status==='processing'){ %><p class="muted">Accepted. Prepare the items and take them out for delivery.</p><form method="post" action="/admin/orders/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= order.id %>"><input type="hidden" name="status" value="shipped"><button class="btn btn-dark">Mark out for delivery</button></form><% } else if(order.status==='shipped'){ %><p class="muted">Collect <strong><%= formatPrice(order.total_cents,order.currency) %></strong> in cash from the customer before completing this order.</p><form method="post" action="/admin/orders/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= order.id %>"><input type="hidden" name="status" value="completed"><button class="btn btn-mint">Delivered & cash received</button></form><% } else if(order.status==='completed'){ %><p class="success-alert">Order delivered and cash recorded as received.</p><% } else { %><p class="muted">This order was declined and reserved stock was released.</p><% } %><p class="muted">Terms accepted: <%= order.terms_accepted_at?formatDateTimeDisplay(order.terms_accepted_at,storeTimeZone):'Not recorded' %></p><p class="muted">Payment: Cash on delivery<% if(order.payment_reference){ %> · received<br>Reference: <%= order.payment_reference %><% } %></p></aside></section>
<%- include('../partials/footer') %>
