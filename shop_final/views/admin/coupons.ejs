<%- include('../partials/header',{title:'Coupons'}) %><nav class="admin-nav container" aria-label="Store manager navigation"><a href="/admin">Overview</a><a href="/admin/products">Products</a><a href="/admin/categories">Categories</a><a href="/admin/orders">Orders</a><a href="/admin/stories">Stories</a><a class="active" aria-current="page" href="/admin/coupons">Discounts</a><a href="/admin/customers">Customers</a><a href="/admin/audit">Audit</a><a href="/admin/settings">Settings</a></nav>
<section class="container page-head admin-head"><%- include('../partials/back-button', { fallback: '/admin' }) %><div><span class="eyebrow">PROMOTIONS</span><h1>Discounts</h1><p>Create percentage or fixed coupons with minimum order and expiry rules. Product sale prices are managed from Products.</p></div></section>
<section class="container admin-two-col section"><form class="panel form-stack" method="post" action="/admin/coupons/save"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(editCoupon?.id){ %><input type="hidden" name="id" value="<%= editCoupon.id %>"><% } %><% if(error){ %><div class="alert" role="alert"><%= error %></div><% } %><h2><%= editCoupon?.id?'Edit coupon':'Create coupon' %></h2><label>Code *<input name="code" maxlength="40" required placeholder="WELCOME10" value="<%= editCoupon?.code||'' %>"></label><div class="form-two"><label>Type<select name="type"><option value="percent" <%= editCoupon?.type==='percent'?'selected':'' %>>Percentage</option><option value="fixed" <%= editCoupon?.type==='fixed'?'selected':'' %>>Fixed amount</option></select></label><label>Value *<input name="value" inputmode="decimal" required placeholder="10" value="<%= editCoupon?.type==='fixed' && editCoupon?.value!=null ? (editCoupon.value/100).toFixed(2) : editCoupon?.value||'' %>"></label></div><label>Minimum order value<input name="minSubtotal" inputmode="decimal" value="<%= editCoupon?.min_subtotal_cents!=null ? (editCoupon.min_subtotal_cents/100).toFixed(2) : '0' %>" placeholder="0.00"></label><label>Expiry<input type="datetime-local" name="expiresAt" value="<%= editCoupon?.expires_at?formatDateTimeLocal(editCoupon.expires_at,storeTimeZone): '' %>"></label><label class="checkbox-inline"><input type="checkbox" name="active" <%= editCoupon ? (editCoupon.active?'checked':'') : 'checked' %>> Active</label><div class="form-actions"><button class="btn btn-dark btn-wide"><%= editCoupon?.id?'Save changes':'Create coupon' %></button><% if(editCoupon?.id){ %><a class="btn btn-light btn-wide" href="/admin/coupons">Cancel edit</a><% } %></div></form><div class="panel table-wrap"><table><thead><tr><th>Code</th><th>Discount</th><th>Minimum</th><th>Expiry</th><th>Status</th><th></th></tr></thead><tbody><% coupons.forEach(c=>{ %><tr><td><strong><%= c.code %></strong></td><td><%= c.type==='percent'?c.value+'%':formatPrice(c.value,currency) %></td><td><%= formatPrice(c.min_subtotal_cents,currency) %></td><td><%= c.expires_at?formatDateTimeDisplay(c.expires_at,storeTimeZone):'No expiry' %></td><td><span class="status <%= c.active?'':'off' %>"><%= c.active?'Active':'Disabled' %></span></td><td class="table-actions"><a class="btn btn-light btn-small" href="/admin/coupons?edit=<%= c.id %>">Edit</a><form method="post" action="/admin/coupons/delete" data-confirm="Delete coupon <%= c.code %>?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= c.id %>"><button class="btn btn-danger btn-small">Delete</button></form></td></tr><% }) %></tbody></table></div></section>
<%- include('../partials/footer') %>