<%- include('../partials/header',{title:'Customers'}) %><nav class="admin-nav container" aria-label="Store manager navigation"><a href="/admin">Overview</a><a href="/admin/products">Products</a><a href="/admin/categories">Categories</a><a href="/admin/orders">Orders</a><a href="/admin/stories">Stories</a><a href="/admin/coupons">Discounts</a><a class="active" aria-current="page" href="/admin/customers">Customers</a><a href="/admin/audit">Audit</a><a href="/admin/settings">Settings</a></nav>
<section class="container page-head admin-head"><div><span class="eyebrow">CUSTOMERS</span><h1>Customers.</h1><p>Contact information is shown here only to an authorised manager. Full delivery details stay on each order.</p></div></section>
<section class="container section"><form class="admin-filters panel" method="get" action="/admin/customers"><div><label for="customer-search">Search</label><input id="customer-search" name="search" value="<%= search %>" maxlength="120" placeholder="Customer email"></div><button class="btn btn-dark">Search</button><a class="btn btn-light" href="/admin/customers">Reset</a></form></section>
<section class="container section section-topless"><div class="table-meta"><span><strong><%= total %></strong> customers</span><span>Page <%= page %></span></div><div class="panel table-wrap"><table><thead><tr><th>Customer</th><th>Phone</th><th>Latest location</th><th>Orders</th><th>Lifetime value</th></tr></thead><tbody><% customers.forEach(c=>{ %><tr><td><strong><%= c.email %></strong><br><span class="muted">Joined <%= formatDateTimeDisplay(c.created_at,storeTimeZone).split(',')[0] %></span></td><td><%= c.phone||'—' %></td><td><%= c.last_city||'—' %><%= c.last_country?', '+c.last_country:'' %></td><td><%= c.order_count %></td><td><strong><%= formatPrice(c.lifetime_value_cents,currency) %></strong></td></tr><% }) %><% if(!customers.length){ %><tr><td colspan="5"><div class="empty compact"><h3>No customers found.</h3><a href="/admin/customers" class="text-link">Clear search →</a></div></td></tr><% } %></tbody></table></div><div class="pagination"><% if(hasPrev){ %><a class="btn btn-light btn-small" href="/admin/customers?page=<%= page-1 %>&search=<%= encodeURIComponent(search) %>">← Previous</a><% } else { %><span></span><% } %><span>Page <strong><%= page %></strong></span><% if(hasNext){ %><a class="btn btn-dark btn-small" href="/admin/customers?page=<%= page+1 %>&search=<%= encodeURIComponent(search) %>">Next →</a><% } else { %><span></span><% } %></div></section>
<%- include('../partials/footer') %>