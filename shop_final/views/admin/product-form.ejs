<%- include('../partials/header',{title:product?.id?'Edit product':'Add product'}) %><nav class="admin-nav container" aria-label="Store manager navigation"><a href="/admin">Overview</a><a class="active" aria-current="page" href="/admin/products">Products</a><a href="/admin/categories">Categories</a><a href="/admin/orders">Orders</a><a href="/admin/stories">Stories</a><a href="/admin/coupons">Discounts</a><a href="/admin/customers">Customers</a><a href="/admin/audit">Audit</a><a href="/admin/settings">Settings</a></nav>
<section class="container page-head admin-head"><div><span class="eyebrow">CATALOG · <%= product?.id?'EDIT':'NEW' %></span><h1><%= product?.id?'Edit product':'Add product' %></h1><p>Step 1 has everything you need. Step 2 is optional. Fields marked * are required.</p></div></section>
<section class="container form-page"><form class="panel form-stack" method="post" action="/admin/products/save" data-shop-currency="<%= currency %>" enctype="multipart/form-data" data-product-form novalidate><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(product?.id){ %><input type="hidden" name="id" value="<%= product.id %>"><% } %><% const errs=(typeof errors!=='undefined'&&errors&&errors.length)?errors:(error?[error]:[]); %><% if(errs.length){ %><div class="alert" role="alert"><strong>Please fix the following:</strong><ul><% errs.forEach(e=>{ %><li><%= e %></li><% }) %></ul></div><% } %>
<div class="form-section"><span class="eyebrow">STEP 1 · ESSENTIALS</span><h2>What are you selling?</h2>
<label>Product name *<input name="name" required maxlength="120" data-field="name" value="<%= product?.name||'' %>" placeholder="Example: Everyday Backpack"><span class="field-msg" data-msg></span></label>
<div class="form-two"><label>Regular price *<input data-price-input data-field="price" inputmode="decimal" name="price" required min="0.01" step="0.01" placeholder="89.00" value="<%= product?.price_cents!=null?(product.price_cents/100).toFixed(2):'' %>"><span class="field-msg" data-msg></span></label><label>Stock *<input type="number" min="0" max="100000000" name="stock" data-field="stock" required value="<%= product?.stock??0 %>"><span class="field-msg" data-msg></span></label></div>
<div class="form-two"><label>SKU * <small>(auto-generated from the name, you can change it)</small><input name="sku" data-sku-input data-product-id="<%= product?.id||'' %>" required maxlength="60" value="<%= product?.sku||'' %>" placeholder="BAG-001"><span class="field-msg" data-msg data-sku-msg></span></label><label>Category<select name="categoryId"><option value="">No category</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= String(product?.category_id||'')===String(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select></label></div>
<div class="upload-grid"><label>Image<div class="dropzone" data-dropzone><input type="file" name="image" accept="image/jpeg,image/png,image/webp" data-image-input><span class="field-note">Drag &amp; drop here or click to choose · JPG, PNG or WebP · max 5 MB</span></div><img class="image-preview" data-image-preview alt="Image preview" <%= product?.image_url?'':'hidden' %> <% if(product?.image_url){ %>src="<%= product.image_url %>"<% } %>></label><label>Or image URL<input name="imageUrl" data-image-url maxlength="500" value="<%= product?.image_url||'' %>" placeholder="https://…"><span class="field-note">Use a trusted HTTPS image source.</span></label></div>
<div class="checkboxes"><label><input type="checkbox" name="featured" <%= product?.featured?'checked':'' %>> Featured on the homepage</label><label><input type="checkbox" name="active" <%= product ? product.active?'checked':'' : 'checked' %>> Visible in the shop</label></div></div>
<details class="form-section optional-section" <%= (product&&(product.short_description||product.description||product.tags||product.sale_price_cents!=null||product.sale_start||product.sale_end||product.formSaleStart||product.formSaleEnd||Number(product.automatic_discount_percent)>0))?'open':'' %>><summary><span class="eyebrow">STEP 2 · OPTIONAL</span> Descriptions, sale &amp; discounts, tags</summary>
<label>Short description<textarea name="shortDescription" maxlength="300" rows="3" placeholder="One clear sentence customers see first."><%= product?.short_description||'' %></textarea></label><label>Description<textarea name="description" maxlength="5000" rows="6" placeholder="Detailed product information, specifications and useful details."><%= product?.description||'' %></textarea></label><label>Tags<input name="tags" maxlength="300" value="<%= product?.tags||'' %>" placeholder="travel, work, minimal"></label>
<div class="form-two"><label>Sale price<input data-sale-input data-field="sale" inputmode="decimal" name="salePrice" min="0.01" step="0.01" placeholder="69.00" value="<%= product?.sale_price_cents!=null?(product.sale_price_cents/100).toFixed(2):'' %>"><span class="field-msg" data-msg></span><span class="discount-preview" data-discount-preview>Optional scheduled sale price. Must be lower than the regular price.</span></label><label>Automatic discount %<input type="number" name="automaticDiscountPercent" min="0" max="90" step="1" required inputmode="numeric" value="<%= product?.automatic_discount_percent ?? 0 %>"><span class="field-note">0% means no automatic discount. This setting applies only to this product.</span></label></div>
<div class="form-two"><label>Sale starts<input type="datetime-local" name="saleStart" value="<%= product?.formSaleStart!==undefined?product.formSaleStart:(product?.sale_start?formatDateTimeLocal(product.sale_start,storeTimeZone):'') %>"><span class="field-note">Leave blank for an immediate sale. Store timezone.</span></label><label>Sale ends<input type="datetime-local" name="saleEnd" data-field="saleEnd" value="<%= product?.formSaleEnd!==undefined?product.formSaleEnd:(product?.sale_end?formatDateTimeLocal(product.sale_end,storeTimeZone):'') %>"><span class="field-msg" data-msg></span><span class="field-note">Leave blank for no expiry. Must be after the start.</span></label></div></details>
<button class="btn btn-mint btn-wide">Save product</button><a class="btn btn-light btn-wide" href="/admin/products">Cancel</a></form></section>
<%- include('../partials/footer') %>