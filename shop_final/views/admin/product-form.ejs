<%- include('../partials/header',{title:product?.id?'Edit product':'Add product'}) %><nav class="admin-nav container" aria-label="Store manager navigation"><a href="/admin">Overview</a><a class="active" aria-current="page" href="/admin/products">Products</a><a href="/admin/categories">Categories</a><a href="/admin/orders">Orders</a><a href="/admin/stories">Stories</a><a href="/admin/coupons">Discounts</a><a href="/admin/customers">Customers</a><a href="/admin/audit">Audit</a><a href="/admin/settings">Settings</a></nav>
<section class="container page-head admin-head"><div><span class="eyebrow">CATALOG · <%= product?.id?'EDIT':'NEW' %></span><h1><%= product?.id?'Edit product':'Add product' %></h1><p>Fill in the essential information, set the sale window, then choose whether the product is visible to customers.</p></div></section>
<section class="container form-page"><form class="panel form-stack" method="post" action="/admin/products/save" data-shop-currency="<%= currency %>" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(product?.id){ %><input type="hidden" name="id" value="<%= product.id %>"><% } %><% if(error){ %><div class="alert" role="alert"><%= error %></div><% } %>
<div class="form-section"><span class="eyebrow">01 · PRODUCT</span><h2>What are you selling?</h2><label>Product name *<input name="name" required maxlength="120" value="<%= product?.name||'' %>" placeholder="Example: Everyday Backpack"></label><div class="form-two"><label>SKU *<input name="sku" required maxlength="60" value="<%= product?.sku||'' %>" placeholder="BAG-001"></label><label>Category<select name="categoryId"><option value="">No category</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= String(product?.category_id||'')===String(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select></label></div><label>Short description<textarea name="shortDescription" maxlength="300" rows="3" placeholder="One clear sentence customers see first."><%= product?.short_description||'' %></textarea></label><label>Description<textarea name="description" maxlength="5000" rows="8" placeholder="Detailed product information, specifications and useful details."><%= product?.description||'' %></textarea></label><label>Tags<input name="tags" maxlength="300" value="<%= product?.tags||'' %>" placeholder="travel, work, minimal"></label></div>
<div class="form-section"><span class="eyebrow">02 · PRICING</span><h2>Price & discount</h2><div class="form-two"><label>Regular price *<input data-price-input inputmode="decimal" name="price" required min="0.01" step="0.01" placeholder="89.00" value="<%= product?.price_cents!=null?(product.price_cents/100).toFixed(2):'' %>"></label><label>Sale price<input data-sale-input inputmode="decimal" name="salePrice" min="0.01" step="0.01" placeholder="69.00" value="<%= product?.sale_price_cents!=null?(product.sale_price_cents/100).toFixed(2):'' %>"><span class="discount-preview" data-discount-preview>Optional scheduled sale price. The item discount above is separate and applies to the active price.</span></label></div><div class="form-two"><label>Automatic discount %<input type="number" name="automaticDiscountPercent" min="0" max="90" step="1" required inputmode="numeric" value="<%= product?.automatic_discount_percent ?? product?.automaticDiscountPercent ?? 0 %>"><span class="field-note">0% means no automatic discount. This setting applies only to this product.</span></label><label>Sale starts<input type="datetime-local" name="saleStart" value="<%= product?.sale_start?formatDateTimeLocal(product.sale_start,storeTimeZone):'' %>"><span class="field-note">Leave blank for an immediate sale. Times use the store timezone.</span></label></div><label>Sale ends<input type="datetime-local" name="saleEnd" value="<%= product?.sale_end?formatDateTimeLocal(product.sale_end,storeTimeZone):'' %>"><span class="field-note">Leave blank for no expiry. Times use the store timezone.</span></label><div class="tip-box">The browser is never trusted with the final price. The server recalculates the price and discount again during checkout.</div></div>
<div class="form-section"><span class="eyebrow">03 · STOCK</span><h2>How many are available?</h2><label>Total stock *<input type="number" min="0" max="100000000" name="stock" required value="<%= product?.stock??0 %>"><span class="field-note">Reserved checkout stock cannot be accidentally overwritten.</span></label></div>
<div class="form-section"><span class="eyebrow">04 · IMAGE</span><h2>Make it look good.</h2><div class="upload-grid"><label>Upload image<input type="file" name="image" accept="image/jpeg,image/png,image/webp"><span class="field-note">JPG, PNG or WebP · max 5 MB · use a clear product photo.</span></label><label>Or image URL<input name="imageUrl" maxlength="500" value="<%= product?.image_url||'' %>" placeholder="https://…"><span class="field-note">Use a trusted HTTPS image source.</span></label></div></div>
<div class="form-section"><span class="eyebrow">05 · PUBLISH</span><h2>Make it visible.</h2><div class="checkboxes"><label><input type="checkbox" name="featured" <%= product?.featured?'checked':'' %>> Featured on the homepage</label><label><input type="checkbox" name="active" <%= product ? product.active?'checked':'' : 'checked' %>> Visible in the shop</label></div></div>
<button class="btn btn-mint btn-wide">Save product</button><a class="btn btn-light btn-wide" href="/admin/products">Cancel</a></form></section>
<%- include('../partials/footer') %>