<%- include('../partials/header',{title:'Products'}) %><nav class="admin-nav container" aria-label="Store manager navigation"><a href="/admin">Overview</a><a class="active" aria-current="page" href="/admin/products">Products</a><a href="/admin/categories">Categories</a><a href="/admin/orders">Orders</a><a href="/admin/stories">Stories</a><a href="/admin/coupons">Discounts</a><a href="/admin/customers">Customers</a><a href="/admin/audit">Audit</a><a href="/admin/settings">Settings</a></nav>
<section class="container page-head admin-head"><div><span class="eyebrow">CATALOG</span><h1>Products.</h1><p>Add or edit anything customers can buy. Price, sale, dates, stock, category and visibility are all controlled here.</p></div><a class="btn btn-mint" href="/admin/products/new">+ Add product</a></section>
<section class="container section"><form class="admin-filters panel" method="get" action="/admin/products"><div><label for="product-search">Search products</label><input id="product-search" name="search" value="<%= search %>" maxlength="80" placeholder="Name, SKU or keyword"></div><div><label for="product-category">Category</label><select id="product-category" name="category"><option value="">All categories</option><% categories.forEach(c=>{ %><option value="<%= c.slug %>" <%= category===c.slug?'selected':'' %>><%= c.name %></option><% }) %></select></div><button class="btn btn-dark">Filter</button><a class="btn btn-light" href="/admin/products">Reset</a></form></section>
<section class="container section section-topless"><div class="table-meta"><span><strong><%= total %></strong> products</span><span>Page <%= page %></span></div><div class="panel table-wrap"><table><thead><tr><th>Product</th><th>Price</th><th>Stock</th><th>Visibility</th><th></th></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><div class="table-product"><img src="<%= safeImageUrl(p.image_url) %>" alt=""><div><strong><%= p.name %></strong><span><%= p.sku %> · <%= p.category_name||'Uncategorised' %></span></div></div></td><td><strong><%= formatPrice(app.locals.effectivePrice(p),currency) %></strong><% if(Number(p.automatic_discount_percent)>0){ %><br><span class="status">-<%= p.automatic_discount_percent %>% item</span><% } %><% if(app.locals.effectivePrice(p)<p.price_cents){ %><br><del class="muted"><%= formatPrice(p.price_cents,currency) %></del><% } %></td><td><%= Math.max(0,p.available_stock) %> available<% if(p.reserved_stock){ %><br><span class="muted"><%= p.reserved_stock %> reserved</span><% } %></td><td><span class="status <%= p.active?'':'off' %>"><%= p.active?'Live':'Hidden' %></span></td><td class="table-actions"><a class="btn btn-light btn-small" href="/admin/products/<%= p.id %>/edit">Edit</a></td></tr><% }) %><% if(!products.length){ %><tr><td colspan="5"><div class="empty compact"><h3>No products found.</h3><a href="/admin/products/new" class="text-link">Add the first product →</a></div></td></tr><% } %></tbody></table></div><div class="pagination"><% if(hasPrev){ %><a class="btn btn-light btn-small" href="/admin/products?page=<%= page-1 %>&search=<%= encodeURIComponent(search) %>&category=<%= encodeURIComponent(category) %>">← Previous</a><% } else { %><span></span><% } %><span>Page <strong><%= page %></strong></span><% if(hasNext){ %><a class="btn btn-dark btn-small" href="/admin/products?page=<%= page+1 %>&search=<%= encodeURIComponent(search) %>&category=<%= encodeURIComponent(category) %>">Next →</a><% } else { %><span></span><% } %></div></section>
<%- include('../partials/footer') %>