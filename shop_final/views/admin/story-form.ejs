<%- include('../partials/header',{title:story?.id?'Edit story':'Add story'}) %><nav class="admin-nav container" aria-label="Store manager navigation"><a href="/admin">Overview</a><a href="/admin/products">Products</a><a href="/admin/categories">Categories</a><a href="/admin/orders">Orders</a><a class="active" aria-current="page" href="/admin/stories">Stories</a><a href="/admin/coupons">Discounts</a><a href="/admin/customers">Customers</a><a href="/admin/audit">Audit</a><a href="/admin/settings">Settings</a></nav>
<section class="container page-head admin-head"><%- include('../partials/back-button', { fallback: '/admin/stories' }) %><div><span class="eyebrow">CONTENT</span><h1><%= story?.id?'Edit story':'Add story' %></h1><p>Stories automatically disappear after their expiration time. Times use the store timezone.</p></div></section>
<section class="container form-page"><form class="panel form-stack" method="post" action="/admin/stories/save" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if(story?.id){ %><input type="hidden" name="id" value="<%= story.id %>"><% } %><% if(error){ %><div class="alert" role="alert"><%= error %></div><% } %><label>Title *<input name="title" required maxlength="120" value="<%= story?.title||'' %>"></label><label>Text<textarea name="body" maxlength="1000" rows="5"><%= story?.body||'' %></textarea></label><div class="form-two"><label>Publish at *<input type="datetime-local" name="publishedAt" required value="<%= story?.published_at?formatDateTimeLocal(story.published_at,storeTimeZone): '' %>"></label><label>Expire at *<input type="datetime-local" name="expiresAt" required value="<%= story?.expires_at?formatDateTimeLocal(story.expires_at,storeTimeZone): '' %>"></label></div><label>Attach product<select name="productId"><option value="">No product</option><% products.forEach(p=>{ %><option value="<%= p.id %>" <%= String(story?.product_id||'')===String(p.id)?'selected':'' %>><%= p.name %></option><% }) %></select></label><label>Link URL<input name="linkUrl" maxlength="500" placeholder="/shop" value="<%= story?.link_url||'' %>"></label><div class="upload-grid"><label>Upload image<input type="file" name="image" accept="image/jpeg,image/png,image/webp"></label><label>Or image URL<input name="imageUrl" maxlength="500" value="<%= story?.image_url||'' %>"></label></div><label class="checkbox-inline"><input type="checkbox" name="active" <%= story ? story.active?'checked':'' : 'checked' %>> Active</label><button class="btn btn-dark btn-wide">Save story</button></form></section>
<%- include('../partials/footer') %>