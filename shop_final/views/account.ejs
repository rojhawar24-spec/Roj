<%- include('partials/header',{title:'Account'}) %>
<section class="container page-head"><span class="eyebrow"><%= user.role==='admin'?'ADMIN ACCOUNT':user.role==='manager'?'MANAGER ACCOUNT':'ACCOUNT' %></span><h1>Hello.</h1><p><%= user.email %></p></section>
<% if(user.role==='admin'||user.role==='manager'){ %><section class="container account-grid"><div class="panel manager-account-card"><div class="panel-head"><div><span class="eyebrow">STORE CONTROL</span><h2>Manager access</h2></div><span class="status"><%= user.role==='admin'?'Admin':'Manager' %></span></div><p class="muted">Your manager account can control products, discounts, stories, orders, customers and store settings.</p><div class="quick-links"><a class="btn btn-dark" href="/admin">Open manager</a><a class="btn btn-light" href="/account/security">Account security</a></div></div></section><% } %>
<section class="container account-grid"><div class="panel"><div class="panel-head"><div><span class="eyebrow">ORDERS</span><h2>Your orders</h2></div><div class="quick-links"><a class="btn btn-light" href="/account/security">Account security</a><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-light" type="submit">Sign out</button></form></div></div><% if(orders.length){orders.forEach(o=>{ %><a class="order-row" href="/account/order/<%= o.id %>"><div><strong>Order #<%= o.id %></strong><span><%= formatDateTimeDisplay(o.created_at,storeTimeZone).split(',')[0] %></span></div><div><span class="status"><%= o.status %></span><strong><%= formatPrice(o.total_cents,o.currency) %></strong></div></a><% }) %><% } else { %><div class="empty compact"><h3>No orders yet.</h3><a href="/shop" class="text-link">Browse products →</a></div><% } %></div></section>
<%- include('partials/footer') %>
