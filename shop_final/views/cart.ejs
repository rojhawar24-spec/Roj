<%- include('partials/header',{title:'Cart'}) %>
<section class="container page-head"><%- include('partials/back-button', { fallback: '/shop' }) %><span class="eyebrow">YOUR BAG</span><h1>Cart</h1><p>Prices and available stock are checked again before checkout.</p></section>
<section class="container cart-layout"><% if(couponMessage){ %><div class="alert cart-message"><%= couponMessage==='applied'?'Coupon applied.':couponMessage==='invalid'?'That coupon is invalid or expired.':couponMessage==='minimum'?'Your order does not meet the coupon minimum.':'Coupon cleared.' %></div><% } %>
<div class="panel cart-list"><% if(!items.length){ %><div class="empty compact"><span class="empty-icon">Bag</span><h2>Your bag is empty.</h2><p>Browse the catalog and add something you like.</p><a href="/shop" class="btn btn-dark">Start shopping</a></div><% } else { items.forEach(i=>{ %><div class="cart-item"><a href="/product/<%= i.product.slug %>"><img src="<%= safeImageUrl(i.product.image_url) %>" alt="<%= i.product.name %>"></a><div class="cart-info"><span class="muted"><%= i.product.sku %></span><h3><a href="/product/<%= i.product.slug %>"><%= i.product.name %></a></h3><p><%= formatPrice(i.price,currency) %> each<% if(i.automaticDiscountPercent>0){ %> · -<%= i.automaticDiscountPercent %>% item discount<% } %></p><form method="post" action="/cart/update" class="qty-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="productId" value="<%= i.product.id %>"><label class="sr-only" for="qty-<%= i.product.id %>">Quantity for <%= i.product.name %></label><input id="qty-<%= i.product.id %>" type="number" name="quantity" min="1" max="<%= Math.min(99,i.product.available_stock) %>" value="<%= i.quantity %>"><button class="icon-btn">Update</button></form></div><strong class="cart-line-total"><%= formatPrice(i.total,currency) %></strong><form method="post" action="/cart/remove" data-confirm="Remove this item from your cart?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="productId" value="<%= i.product.id %>"><button class="icon-btn" aria-label="Remove <%= i.product.name %>">×</button></form></div><% }) } %></div>
<aside class="summary"><div class="summary-head">Order summary</div><div class="summary-row"><span>Items subtotal</span><strong><%= formatPrice(subtotalBeforeAutomaticDiscount,currency) %></strong></div><% if(automaticDiscount>0){ %><div class="summary-row"><span>Automatic item discounts</span><strong>-<%= formatPrice(automaticDiscount,currency) %></strong></div><% } %><% if(discount>0){ %><div class="summary-row"><span>Coupon<% if(coupon){ %> · <%= coupon.code %><% } %></span><strong>-<%= formatPrice(discount,currency) %></strong></div><% } %><div class="summary-row"><span>Shipping</span><strong><%= shipping===0?'Free':formatPrice(shipping,currency) %></strong></div><div class="rule"></div><div class="summary-row total"><span>Total</span><strong><%= formatPrice(total,currency) %></strong></div><form method="post" action="/cart/coupon" class="coupon-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="sr-only" for="coupon-code">Coupon code</label><input id="coupon-code" name="code" maxlength="40" placeholder="Coupon code" value="<%= coupon?.code||'' %>"><button class="btn btn-light">Apply</button></form><% if(couponIneligible){ %><small>This coupon needs a higher subtotal before it can be applied.</small><% } %><% if(items.length){ %><a class="btn btn-dark btn-wide checkout-btn" href="/checkout">Continue to checkout</a><% } %><small><%= automaticDiscount>0 ? 'The eligible product discounts are already applied. ' : '' %>Final price, discounts, stock and shipping are recalculated on the server.</small></aside>
</section>
<%- include('partials/footer') %>