<%- include('partials/header',{title:product.name}) %>
<section class="container product-detail"><div><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/shop">Shop</a><% if(product.category_slug){ %><span aria-hidden="true">/</span><a href="/shop?category=<%= encodeURIComponent(product.category_slug) %>"><%= product.category_name || product.category_slug %></a><% } %><span aria-hidden="true">/</span><span aria-current="page"><%= product.name %></span></nav><a class="back-link" href="/shop">← Back to shop</a><div class="product-visual"><img src="<%= safeImageUrl(product.image_url) %>" alt="<%= product.name %>" width="800" height="1000" decoding="async"></div></div><div class="product-copy"><span class="eyebrow"><%= product.category_name || 'Collection' %></span><h1><%= product.name %></h1><p class="lead"><%= product.short_description %></p><div class="detail-price"><span><%= formatPrice(app.locals.effectivePrice(product),currency) %></span><% if(app.locals.effectivePrice(product)<product.price_cents){ %><del><%= formatPrice(product.price_cents,currency) %></del><span class="discount">-<%= app.locals.discountPercent(product) %>%</span><% } %></div><div class="stock-line"><span class="dot <%= product.available_stock>0?'ok':'bad' %>"></span><%= product.available_stock>0 ? product.available_stock+' available' : 'Currently sold out' %></div><p class="detail-description"><%= product.description %></p><div class="rule"></div><div class="buy-row"><form method="post" action="/cart/add" class="buy-box"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="productId" value="<%= product.id %>"><label>Quantity<input type="number" name="quantity" min="1" max="<%= Math.min(99,product.available_stock) %>" value="1" <%= product.available_stock<=0?'disabled':'' %>></label><button class="btn btn-mint" <%= product.available_stock<=0?'disabled':'' %>><%= product.available_stock>0?'Add to cart':'Sold out' %></button></form><% if(isLoggedIn){ %><button type="button" class="icon-btn wishlist-toggle product-wishlist <%= wishlistIds.has(product.id)?'saved':'' %>" data-wishlist-toggle data-product-id="<%= product.id %>" data-product-name="<%= product.name %>" aria-label="<%= wishlistIds.has(product.id)?'Remove':'Add' %> <%= product.name %> to wishlist" aria-pressed="<%= wishlistIds.has(product.id)?'true':'false' %>"><%= wishlistIds.has(product.id)?'♥':'♡' %></button><% } %></div><div class="detail-trust"><span>✓ Server-verified price</span><span>✓ Secure account</span><span>↺ Clear returns policy</span></div></div></section>
<%- include('partials/footer') %>
